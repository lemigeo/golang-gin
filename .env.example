HTTP_ADDR=:8080
GIN_MODE=debug

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# 세션 토큰 서명 키. 32자 이상이어야 하며, 유출되면 임의 고객의 토큰을 위조할 수 있다.
SESSION_SECRET=change-me-to-a-random-32-plus-char-string
# 세션 수명 (Go duration). 기본 20m.
SESSION_TTL=20m

DB_DSN=root:root@tcp(127.0.0.1:3306)/app?parseTime=true&multiStatements=true

# 소셜 공급자 API 베이스 URL. 비워두면 실제 공급자를 호출한다.
# 스테이징에서 목 서버로 돌릴 때만 채운다.
KAKAO_API_BASE_URL=
NAVER_API_BASE_URL=
